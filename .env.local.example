# Shopify Storefront API Configuration
# Get these values from your Shopify admin -> Apps -> Develop apps

NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=theindiaffectstore.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token-here

# Note: Leave these empty to deploy without Shopify backend
# The site will show placeholder content and skeleton loaders
